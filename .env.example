# 复制为 .env 后填写。.env 已被 .gitignore 忽略，永远不要提交真实凭据。
KEDAIBIAO_ENV=dev
KEDAIBIAO_LOG_LEVEL=INFO

# 数据库（题库 / 任务记录）
KEDAIBIAO_DB_URL=sqlite:///./data/kedaibiao.db

# 浏览器
KEDAIBIAO_HEADLESS=true
KEDAIBIAO_SESSION_DIR=./data/sessions
KEDAIBIAO_MAX_CONCURRENCY=3

# 通知渠道
KEDAIBIAO_NOTIFY=console

# ---- 平台凭据：(仅) 本项目自行登录用，禁止提交真实值 ----
# 批改网 www.pigai.org —— Stage 1b 只读侦察与 pigai 适配器共用。
# 明文密码不会进网络：适配器按前端同款 RSA-1024 / PKCS#1 v1.5 加密后放入 password_encrypt。
# 详见 docs/research/pigai.md 第 4 节。
KEDAIBIAO_PIGAI_USER=
KEDAIBIAO_PIGAI_PASS=
