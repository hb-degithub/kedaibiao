# 复制为 .env 后填写。.env 已被 .gitignore 忽略，永远不要提交真实凭据。
KEDAIBIAO_ENV=dev
KEDAIBIAO_LOG_LEVEL=INFO

# 数据库（题库 / 任务记录）
KEDAIBIAO_DB_URL=sqlite:///./data/kedaibiao.db

# 浏览器
KEDAIBIAO_HEADLESS=true
KEDAIBIAO_SESSION_DIR=./data/sessions
KEDAIBIAO_MAX_CONCURRENCY=3

# 通知渠道
KEDAIBIAO_NOTIFY=console

# ---- 平台账号不再写在这里 ----
# 平台凭据只能通过控制台「账号」页绑定（或 `kedaibiao web` 里操作）。
# 绑定时会真登录一次，之后只保存该账号自己的会话 cookie，**不落盘密码**。
# 这样做的原因：
#   1. .env 是明文，且容易被 git 误提交；
#   2. 两套来源并存时搞不清「实际用的是哪个号」；
#   3. 一个平台可以有多个号，环境变量表达不了。

# iTEST 智能测评云平台（itestcloud.unipus.cn）—— 用 Unipus 账号登录，SSO 后落 jwt/iTSsiD cookie。
# 明文密码不会进网络：按 Unipus 前端同款 AES-128-CBC（固定 key/IV、大写 hex）加密后再提交。
# 详见 docs/research/itest.md 第 1.3 / 3.7 节。
KEDAIBIAO_ITEST_USER=
KEDAIBIAO_ITEST_PASS=

# ---- 东软智慧教育（neusoft）----
# 不需要填账号密码：账号在控制台「账号」页绑定（会真登录一次，只存会话）。
# 下面这些是**协议与行为**配置，不是凭据。
# 业务域名随学校不同；示例学院用默认值即可。
# KEDAIBIAO_NEUSOFT_BASE_URL=https://study.neusoft.edu.cn
# 强制指定租户，跳过 /system/tenant/app/option 自动解析（取不到列表时才需要）
# KEDAIBIAO_NEUSOFT_TENANT_ID=
# 只处理指定学期，省掉逐学期探测
# KEDAIBIAO_NEUSOFT_TERM_ID=
# 允许真正交卷。交卷不可逆且写路径只有 APK 静态证据，所以默认**只存草稿不交卷**
# KEDAIBIAO_NEUSOFT_ALLOW_SUBMIT=0

# ---- 大模型答题（可选）----
# 走 OpenAI 兼容协议（/chat/completions），DeepSeek / 通义 / 智谱 / vLLM / Ollama 都行。
# 不配就自动跳过，答题链会用 题库 -> 规则 兜底。
# 注意：模型只负责「答出来」，提交仍受 dry_run 与最低置信度门槛约束。
# KEDAIBIAO_LLM_BASE_URL=https://api.deepseek.com/v1
# KEDAIBIAO_LLM_API_KEY=
# KEDAIBIAO_LLM_MODEL=deepseek-chat
# KEDAIBIAO_LLM_TIMEOUT=60
# KEDAIBIAO_LLM_TEMPERATURE=0
